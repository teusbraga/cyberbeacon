{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/tutoriais",
      "destination": "/tutoriais.html"
    },
    {
      "source": "/vitrine",
      "destination": "/tutoriais.html"
    },
    {
      "source": "/bate-olho",
      "destination": "/tutoriais.html"
    },
    {
      "source": "/HTML TUTORIAIS.html",
      "destination": "/tutoriais.html"
    },
    {
      "source": "/HTML%20TUTORIAIS.html",
      "destination": "/tutoriais.html"
    }
  ],
  "headers": [
    {
      "source": "/imgs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
